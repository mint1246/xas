; Test-only package. Production publication requires a catalog and Microsoft signature.
[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=09/25/2026,1.0.0.0
CatalogFile=XasVirtualDisplay.cat
PnpLockdown=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...19041

[Models.NTamd64.10.0...19041]
%DeviceDesc%=Device_Install,Root\XASVirtualDisplay

[Device_Install.NT]
CopyFiles=DriverCopy

[Device_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[Device_Install.NT.Wdf]
UmdfService=XasVirtualDisplay,XasVirtualDisplay_ServiceInstall
UmdfServiceOrder=XasVirtualDisplay
UmdfExtensions=IddCx0104

[XasVirtualDisplay_ServiceInstall]
UmdfLibraryVersion=2.15
ServiceBinary=%13%\XasVirtualDisplay.dll
UmdfExtensions=IddCx0104

[WUDFRD_ServiceInstall]
DisplayName=%WudfRdDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys

[DestinationDirs]
DriverCopy=13

[DriverCopy]
XasVirtualDisplay.dll

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
XasVirtualDisplay.dll=1

[Strings]
ProviderName="XAS"
DeviceDesc="XAS Virtual Linux Display"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DiskName="XAS Virtual Display Driver"
