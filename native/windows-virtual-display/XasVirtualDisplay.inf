; Test-only package. Production publication requires a catalog and Microsoft signature.
[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
ClassVer=2.0
Provider=%ProviderName%
DriverVer=09/25/2026,1.0.0.0
CatalogFile=XasVirtualDisplay.cat
PnpLockdown=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%DeviceDesc%=Device_Install,Root\XASVirtualDisplay

[Device_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy

[Device_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=DeviceHardwareSettings

[DeviceHardwareSettings]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"XasVirtualDisplayGroup"

[Device_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[Device_Install.NT.Wdf]
UmdfService=XasVirtualDisplay,XasVirtualDisplay_ServiceInstall
UmdfServiceOrder=XasVirtualDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[XasVirtualDisplay_ServiceInstall]
UmdfLibraryVersion=2.25
ServiceBinary=%12%\UMDF\XasVirtualDisplay.dll
UmdfExtensions=IddCx0104

[DestinationDirs]
DriverCopy=12,UMDF

[DriverCopy]
XasVirtualDisplay.dll

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
XasVirtualDisplay.dll=1

[Strings]
ProviderName="XAS"
DeviceDesc="XAS Virtual Linux Display"
DiskName="XAS Virtual Display Driver"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
